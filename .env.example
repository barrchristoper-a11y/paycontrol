# ========================================
# ENVIRONMENT CONFIGURATION FOR PAYCONTROL
# ========================================
# Copy this file to .env and fill in with real values
# NEVER commit .env to version control

# ========================================
# General
# ========================================
NODE_ENV=production
PORT=3000

# ========================================
# Database (PostgreSQL)
# ========================================
# Format: postgresql://username:password@host:port/database
# For Neon: https://neon.tech
DATABASE_URL=postgresql://user:password@localhost:5432/paycontrol

# ========================================
# Frontend Configuration
# ========================================
FRONTEND_URL=https://paycontrol.example.com

# ========================================
# JWT Configuration
# ========================================
# Generate secrets with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_here_min_32_chars_generated_with_openssl_rand_hex_32
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_min_32_chars_generated_with_openssl
JWT_REFRESH_EXPIRES_IN=7d

# ========================================
# Plaid (Bank Integration)
# ========================================
# Get from: https://dashboard.plaid.com/
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_key_here
PLAID_ENV=sandbox  # Change to 'production' for live

# ========================================
# Stripe (Payment Processing)
# ========================================
# Get from: https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ========================================
# Alchemy (Blockchain Data)
# ========================================
# Get from: https://www.alchemy.com/
ALCHEMY_API_KEY_ETH=your_alchemy_ethereum_api_key_here
ALCHEMY_API_KEY_SOL=your_alchemy_solana_api_key_here

# ========================================
# CoinGecko (Crypto Prices)
# ========================================
# Free API: https://www.coingecko.com/en/api
# For API key: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=your_coingecko_api_key_here_or_leave_empty_for_free_tier

# ========================================
# Sentry (Error Tracking)
# ========================================
# Get from: https://sentry.io/
SENTRY_DSN_BACKEND=your_sentry_backend_dsn_here

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100  # Requests per window

# ========================================
# IMPORTANT: DO NOT COMMIT .env FILE
# ========================================
# Add .env to .gitignore to prevent accidental commits
# Rotate secrets immediately if .env is ever pushed to a public repo
