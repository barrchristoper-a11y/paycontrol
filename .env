# ========== ENVIRONMENT ==========
NODE_ENV=production
PORT=3000

# ========== DATABASE ==========
# From Neon (Step 1.1)
DATABASE_URL=postgres://user:password@host:5432/dbname

# ========== FRONTEND ==========
# From Vercel (Step 1.3) or your domain
FRONTEND_URL=https://app.yourdomain.com

# ========== JWT ==========
# Generate with: openssl rand -hex 32
JWT_SECRET=your_secure_jwt_secret_here_64_chars_long
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ========== PLAID ==========
# From Plaid (Step 1.5)
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=production  # or 'sandbox' for testing

# ========== STRIPE ==========
# From Stripe (Step 1.6)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ========== CRYPTO APIs ==========
# From CoinGecko (Step 1.7)
COINGECKO_API_KEY=your_coingecko_api_key_here

# From Alchemy (Step 1.8)
ALCHEMY_API_KEY_ETH=your_alchemy_eth_key_here
ALCHEMY_API_KEY_SOL=your_alchemy_sol_key_here

# ========== MONITORING ==========
# From Sentry (Step 1.9)
SENTRY_DSN_BACKEND=your_backend_dsn_here
SENTRY_DSN_FRONTEND=your_frontend_dsn_here

# ========== RATE LIMITING ==========
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ========== COOKIE SETTINGS ==========
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=strict
